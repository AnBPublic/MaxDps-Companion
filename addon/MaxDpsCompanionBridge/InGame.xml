<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- MaxDpsBridgeExp load order. Toggles first; the Bridge.lua runtime
         dependencies (Catalog/MajorCooldowns/Keymap/Bars/MainFallback/Reader)
         follow so the renamed encoder has its companion-only helpers; then
         Bridge.lua itself, then the Exp modules in expansion order. -->
    <Script file="Toggles.lua"/>
    <Script file="Catalog.lua"/>
    <Script file="MajorCooldowns.lua"/>
    <Script file="Keymap.lua"/>
    <Script file="Bars.lua"/>
    <Script file="MainFallback.lua"/>
    <Script file="Reader.lua"/>
    <!-- Ext4 hotbar map provider: after Reader (readiness/binding helpers),
         before Bridge (Bridge paints the cells from MDBX.HotbarWatch.Frame). -->
    <Script file="HotbarWatch.lua"/>
    <Script file="Bridge.lua"/>
    <Script file="InGame/Core.lua"/>
    <Script file="InGame/Profiles.lua"/>
    <Script file="InGame/Overlay.lua"/>
    <Script file="InGame/Settings.lua"/>
    <Script file="InGame/Config.lua"/>
    <Script file="InGame/Slash.lua"/>
</Ui>
