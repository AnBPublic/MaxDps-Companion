<Bindings>
    <!-- The MDCB header is declared ONCE on the first binding. WoW registers a
         header for every <Binding> that carries the attribute, so repeating it
         raises "Binding header MDCB was attempted to be loaded more than once".
         Later bindings omit header and inherit the previous header. -->
    <Binding name="MDCB_TOGGLE_OVERLAY" header="MDCB" category="ADDONS">
        MDCBBinding("Overlay")
    </Binding>
    <Binding name="MDCB_TOGGLE_MAIN" category="ADDONS">
        MDCBBinding("Main")
    </Binding>
    <Binding name="MDCB_TOGGLE_OFFENSIVE" category="ADDONS">
        MDCBBinding("Offensive")
    </Binding>
    <Binding name="MDCB_TOGGLE_DEFENSIVE" category="ADDONS">
        MDCBBinding("Defensive")
    </Binding>
    <Binding name="MDCB_TOGGLE_CONSUMABLE" category="ADDONS">
        MDCBBinding("Consumable")
    </Binding>
    <Binding name="MDCB_TOGGLE_TRINKET" category="ADDONS">
        MDCBBinding("Trinket")
    </Binding>
    <Binding name="MDCB_TOGGLE_INTERRUPT" category="ADDONS">
        MDCBBinding("Interrupt")
    </Binding>
    <Binding name="MDCB_TOGGLE_MOBILITY" category="ADDONS">
        MDCBBinding("Mobility")
    </Binding>
    <Binding name="MDCB_TOGGLE_SELFHEAL" category="ADDONS">
        MDCBBinding("SelfHeal")
    </Binding>
    <Binding name="MDCB_TOGGLE_SOLO" category="ADDONS">
        MDCBBinding("Solo")
    </Binding>
    <Binding name="MDCB_TOGGLE_OOC" category="ADDONS">
        MDCBBinding("OOC")
    </Binding>
    <Binding name="MDCB_TOGGLE_AUTOTARGET" category="ADDONS">
        MDCBBinding("AutoTarget")
    </Binding>
    <Binding name="MDCB_TOGGLE_AUTOINTERACT" category="ADDONS">
        MDCBBinding("AutoInteract")
    </Binding>
    <Binding name="MDCB_TOGGLE_TTK" category="ADDONS">
        MDCBBinding("TTK")
    </Binding>
    <Binding name="MDCB_TOGGLE_CC" category="ADDONS">
        MDCBBinding("CC")
    </Binding>
</Bindings>
