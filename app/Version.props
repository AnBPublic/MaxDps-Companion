<Project>
  <!-- Shared Core/Mac version (P0a scaffolding; Windows keeps its own copy in
       app/MaxDpsCompanion/MaxDpsCompanion.csproj). Bump BOTH on every release:
       ReleaseIdentityTests fails when this file disagrees with the Windows
       assembly, and the macOS release workflow refuses a tag/version mismatch.
       New SDK-style projects opt in via:
         <Import Project="../Version.props" />            (Core, one level down)
         <Import Project="../../Version.props" />         (tests, two levels down) -->
  <PropertyGroup>
    <Version>4.5.7</Version>
    <Codename>Voidlight</Codename>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Codename" Value="$(Codename)" />
  </ItemGroup>
</Project>
