<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- WinUI 3 (Windows App SDK) shell. Unpackaged, framework-dependent:
         WindowsPackageType=None + EnableMsixTooling=true at publish (the
         pairing is required for resources.pri; proven in the winui-spike). -->
    <UseWinUI>true</UseWinUI>
    <UseWindowsForms>false</UseWindowsForms>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\companion.ico</ApplicationIcon>
    <AssemblyName>MaxDpsCompanion</AssemblyName>
    <AssemblyTitle>MaxDPS Companion</AssemblyTitle>
    <Product>MaxDPS Companion</Product>
    <RootNamespace>MaxDpsCompanion</RootNamespace>
    <Version>4.6.0</Version>
    <Codename>Cadence</Codename>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Wave B (4.1 Paragon): the shared brain now lives in MaxDpsCompanion.Core
         and this app consumes it through the ProjectReference below. Everything
         that used to be a byte-identical Windows copy (CombatGate, Knowledge/**,
         Decision/**, Scheduler/**, Telemetry renders, KeyNames, PixelProtocol,
         AppSettings, ToggleSync, ...) is deleted from this project; the Core
         assembly is the single source.

         The one intentional duplicate is RotationEngine (Wave C has not merged
         the engines: this one binds concrete WowWindow/ScreenSampler/KeySender,
         Core's binds IPlatform). Its CS0436 warning is suppressed AT THE SINGLE
         USE SITE (Ui/Shell/ShellWindow.Engine.cs), never project-wide.
         ShadowedTypeGateTests reflects over both assemblies and fails if ANY
         other full type name is defined twice. -->
  </PropertyGroup>

  <!-- Wave B: MAXDPSCOMPANION.CORE IS THE SINGLE SOURCE for the shared brain.
       PrivateAssets="all" stops the reference flowing INTO the test project's
       compilation as an unaliased assembly (the test project references Core
       itself, under an extern alias, so the intentional RotationEngine shadow
       does not make every shared type ambiguous there). -->
  <ItemGroup>
    <ProjectReference Include="..\MaxDpsCompanion.Core\MaxDpsCompanion.Core.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MaxDpsCompanion.Tests" />
    <!-- Release codename is single-sourced from <Codename> and baked into the
         assembly as AssemblyMetadata, so Native.Codename / DisplayVersion can
         never drift from the csproj. -->
    <AssemblyMetadata Include="Codename" Value="$(Codename)" />
  </ItemGroup>

  <!-- Windows App SDK pins are exact and spike-proven (2026-10-11 spike).
       Do not upgrade mid-migration. System.Drawing.Common restores the
       Graphics/Bitmap surface the engine uses (BlockLocator, ColorLearner,
       SpellIconCache) now that the Windows Forms framework reference is gone;
       the <Using> restores the implicit global using for those engine files. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
    <Using Include="System.Drawing" />
  </ItemGroup>

  <!-- P3 (docs/plans/2026-10-11-winui3-v4-migration.md §7): the legacy WinForms
       shell was deleted from disk (MainForm.cs, UiControls.cs, ClassSkillsView.cs
       and every old Ui/*.cs), so the P0 compile Remove/Include scaffold is gone.
       The UI now compiles via default SDK globbing: Ui/Shell (window + views),
       Ui/Controls (primitives), Ui/Foundation (models + tokens), Theme.xaml. -->


  <!-- Loose art next to the exe: title-bar icon + tray/form icon fallback. -->
  <ItemGroup>
    <None Include="assets\icon-256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\companion.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Bundled Geist faces removed in v3 classic UI (A6): the shell uses the
       system variable-font chain (DesignTokens.FamilyName). The ttf/OFL assets
       were deleted with UiFonts; nothing embeds or references them. -->

  <!-- Ability knowledge base: Wave B moved ALL five embedded resources to
       MaxDpsCompanion.Core (the single source). AbilityCatalog /
       AbilityCoverage / ClassSpellBook load them with
       Assembly.GetExecutingAssembly(), so the bytes are read from the Core
       assembly whose LogicalNames are still MaxDpsCompanion.Knowledge.*.
       Do not re-add EmbeddedResource entries here: a Windows-side copy would
       shadow the Core resource and silently fork the catalogue again.
       The per-class overlay files under Knowledge\classes\ stay here: they
       are schema inputs read from disk (tests + tooling), never embedded. -->

</Project>
