<Window
    x:Class="MaxDpsCompanion.Ui.Shell.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Borderless solid-background shell (docs/plans/2026-10-11-winui3-v4-migration.md §3).
         The presenter is configured in code-behind: SetBorderAndTitleBar(false, false),
         resizable, no maximize; DWM rounded corners. The title bar is the drag
         region (InputNonClientPointerSource caption rects); the two buttons are
         Passthrough rects so they keep receiving XAML input. -->
    <Grid x:Name="RootGrid" Background="{StaticResource GroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource TitleBarBrush}"
              BorderBrush="{StaticResource AccentRingBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppIcon"
                   Grid.Column="0"
                   Width="22" Height="22"
                   Margin="14,0,0,0"
                   VerticalAlignment="Center"
                   Source="ms-appx:///assets/icon-256.png" />

            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       Margin="10,0,8,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="{StaticResource TitleBarFontSize}"
                       FontWeight="Bold"
                       CharacterSpacing="20"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />

            <Button x:Name="MinimizeButton"
                    Grid.Column="2"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Click="MinimizeButton_Click"
                    ToolTipService.ToolTip="Minimize"
                    AutomationProperties.Name="Minimize">
                <FontIcon Glyph="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
            </Button>

            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Style="{StaticResource TitleBarCloseButtonStyle}"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="Close"
                    AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
            </Button>
        </Grid>

        <!-- P2-C main screen: BodyHost carries the classic gradient/Exp flat
             ground + the scrolling hero card / toggle rows / button rows
             (built in ShellWindow.Content.cs). -->
        <Grid x:Name="ContentRoot" Grid.Row="1">
            <Grid x:Name="BodyHost" />
        </Grid>

        <!-- P2-C overlay host: the Advanced / Abilities scrims are layered over
             the whole window (title bar included), like the WinForms popups that
             were parented to the Form. Children start Collapsed. -->
        <Grid x:Name="OverlayHost" Grid.RowSpan="2" />
    </Grid>
</Window>
