<!--
    Ui/Theme.xaml — WinUI 3 mirror of the frozen token sources:
      * Ui/Foundation/DesignTokens.cs ("Ethereal Glass x brass" numeric tokens)
      * Ui/Controls/ControlTheme.cs     (same palette as Windows.UI.Color)
      * Ui/Foundation/ExpTheme.cs       (in-game-config dark terminal palette)
    Brushes, radii, spacing, font sizes and font families only; no control
    templates. Values are literal copies — the .cs files stay the single
    source of truth for the engine/UI code, this dictionary exists so XAML
    can consume the same numbers (docs/plans/2026-10-11-winui3-v4-migration.md §7-P1).

    Font sizes are converted from the point values in DesignTokens to
    XAML DIPs: dip = pt * 96 / 72 (pt * 4/3), rounded to 2 decimals.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MaxDpsCompanion">

    <!-- ===================== DesignTokens: colours ===================== -->

    <Color x:Key="BackgroundColor">#FF07090B</Color>
    <Color x:Key="SurfaceColor">#FF101519</Color>
    <Color x:Key="SurfaceElevatedColor">#FF171D23</Color>
    <Color x:Key="SurfaceShellColor">#FF12171B</Color>
    <Color x:Key="BorderColor">#FF232C33</Color>
    <Color x:Key="TextPrimaryColor">#FFF4EFE6</Color>
    <Color x:Key="TextSecondaryColor">#FFA9B4BB</Color>
    <Color x:Key="TextMutedColor">#FF6E7A82</Color>
    <Color x:Key="AccentColor">#FFC9A24A</Color>
    <Color x:Key="AccentSoftColor">#FFE6C878</Color>
    <Color x:Key="SuccessColor">#FF4FD898</Color>
    <Color x:Key="WarningColor">#FFE8B14B</Color>
    <Color x:Key="DangerColor">#FFE36A6F</Color>
    <Color x:Key="InfoColor">#FF6AAEF0</Color>
    <Color x:Key="DisabledColor">#FF49545C</Color>
    <Color x:Key="HairlineColor">#1FFFFFFF</Color>
    <Color x:Key="InnerHighlightColor">#26FFFFFF</Color>
    <Color x:Key="ShadowLineColor">#59000000</Color>
    <Color x:Key="ScrimColor">#FF07090B</Color>
    <!-- ScrollTrack = Blend(White, Background, 0.03) from DesignTokens. -->
    <Color x:Key="ScrollTrackColor">#FF0E1012</Color>
    <Color x:Key="ScrollThumbColor">#4DFFFFFF</Color>
    <Color x:Key="GlowBrassColor">#14C9A24A</Color>
    <Color x:Key="GlowTealColor">#10388C78</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceShellBrush" Color="{StaticResource SurfaceShellColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="InnerHighlightBrush" Color="{StaticResource InnerHighlightColor}" />
    <SolidColorBrush x:Key="ShadowLineBrush" Color="{StaticResource ShadowLineColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="GlowBrassBrush" Color="{StaticResource GlowBrassColor}" />
    <SolidColorBrush x:Key="GlowTealBrush" Color="{StaticResource GlowTealColor}" />

    <!-- v4.0.1 glass polish: hairline ring (white 6%), bezel wash (white 4%),
         glyph-chip fills (white 10% / black 12%) and the vertical top-edge
         highlight gradient. Same values as ControlTheme.Ring/BezelWash/... -->
    <Color x:Key="RingColor">#0FFFFFFF</Color>
    <Color x:Key="BezelWashColor">#0AFFFFFF</Color>
    <Color x:Key="ChipLightColor">#1AFFFFFF</Color>
    <Color x:Key="ChipDarkColor">#1F000000</Color>
    <SolidColorBrush x:Key="RingBrush" Color="{StaticResource RingColor}" />
    <SolidColorBrush x:Key="BezelWashBrush" Color="{StaticResource BezelWashColor}" />
    <SolidColorBrush x:Key="ChipLightBrush" Color="{StaticResource ChipLightColor}" />
    <SolidColorBrush x:Key="ChipDarkBrush" Color="{StaticResource ChipDarkColor}" />
    <LinearGradientBrush x:Key="TopEdgeHighlightBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#16FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================== DesignTokens: spacing ===================== -->

    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>
    <x:Double x:Key="SpaceXxxl">40</x:Double>

    <!-- ===================== DesignTokens: radii ======================= -->

    <x:Double x:Key="RadiusOuter">20</x:Double>
    <x:Double x:Key="RadiusInner">14</x:Double>
    <x:Double x:Key="RadiusTile">12</x:Double>
    <x:Double x:Key="RadiusControl">10</x:Double>

    <!-- ============ DesignTokens: type scale (pt -> DIP) =============== -->

    <x:Double x:Key="DisplayFontSize">26.67</x:Double>
    <x:Double x:Key="TitleFontSize">20</x:Double>
    <x:Double x:Key="SectionFontSize">17.33</x:Double>
    <x:Double x:Key="LabelFontSize">14.67</x:Double>
    <x:Double x:Key="BodyFontSize">13.33</x:Double>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="MetaFontSize">11.33</x:Double>
    <x:Double x:Key="MicroFontSize">10.67</x:Double>
    <!-- MainForm title label was 9.5 pt bold -> 12.67 DIP. -->
    <x:Double x:Key="TitleBarFontSize">12.67</x:Double>

    <!-- DesignTokens.FamilyName first choice; DirectWrite falls back to
         Segoe UI when the variable family is absent (Windows 10). -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text</FontFamily>

    <!-- ===================== ExpTheme (dark terminal) ================== -->

    <Color x:Key="ExpBgColor">#FF0B1110</Color>
    <Color x:Key="ExpCardColor">#FF131C1A</Color>
    <Color x:Key="ExpBorderColor">#FF25312E</Color>
    <Color x:Key="ExpAccentColor">#FFE8C558</Color>
    <Color x:Key="ExpDangerColor">#FFE5604F</Color>
    <Color x:Key="ExpOkColor">#FF4CC38A</Color>
    <Color x:Key="ExpTextColor">#FFEDEFF0</Color>
    <Color x:Key="ExpSecondaryColor">#FF9AA5A1</Color>
    <Color x:Key="ExpMonoStampColor">#FF5E6B67</Color>

    <SolidColorBrush x:Key="ExpBgBrush" Color="{StaticResource ExpBgColor}" />
    <SolidColorBrush x:Key="ExpCardBrush" Color="{StaticResource ExpCardColor}" />
    <SolidColorBrush x:Key="ExpBorderBrush" Color="{StaticResource ExpBorderColor}" />
    <SolidColorBrush x:Key="ExpAccentBrush" Color="{StaticResource ExpAccentColor}" />
    <SolidColorBrush x:Key="ExpDangerBrush" Color="{StaticResource ExpDangerColor}" />
    <SolidColorBrush x:Key="ExpOkBrush" Color="{StaticResource ExpOkColor}" />
    <SolidColorBrush x:Key="ExpTextBrush" Color="{StaticResource ExpTextColor}" />
    <SolidColorBrush x:Key="ExpSecondaryBrush" Color="{StaticResource ExpSecondaryColor}" />
    <SolidColorBrush x:Key="ExpMonoStampBrush" Color="{StaticResource ExpMonoStampColor}" />

    <x:Double x:Key="ExpRadiusOuter">20</x:Double>
    <x:Double x:Key="ExpRadiusInner">10</x:Double>
    <x:Double x:Key="ExpControlHeight">42</x:Double>
    <!-- Exp mono family (old ExpTheme.MonoFamily first choice); fallback is automatic. -->
    <FontFamily x:Key="ExpMonoFontFamily">Cascadia Mono</FontFamily>

    <!-- ===================== shell-only helpers ======================== -->

    <!-- Title-bar buttons (MainForm TitleBarButton parity: 48x48 flat hit
         target; hover/pressed visuals come from the default Button template). -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ============ P2-B: console palette (legacy ConsolePalette) ====== -->

    <Color x:Key="IronColor">#FF1A262C</Color>
    <Color x:Key="ConsoleTitleBarColor">#FF141E23</Color>
    <Color x:Key="ConsolePanelColor">#FF212F36</Color>
    <Color x:Key="ConsoleFieldColor">#FF24343C</Color>
    <Color x:Key="KeylineColor">#FF3A4A52</Color>
    <Color x:Key="BoneColor">#FFE9E3D3</Color>
    <Color x:Key="TidewashColor">#FF93A5AE</Color>
    <Color x:Key="EmberColor">#FFB23A2C</Color>
    <Color x:Key="EmberLightColor">#FFE0684E</Color>

    <SolidColorBrush x:Key="IronBrush" Color="{StaticResource IronColor}" />
    <SolidColorBrush x:Key="ConsoleTitleBarBrush" Color="{StaticResource ConsoleTitleBarColor}" />
    <SolidColorBrush x:Key="ConsolePanelBrush" Color="{StaticResource ConsolePanelColor}" />
    <SolidColorBrush x:Key="ConsoleFieldBrush" Color="{StaticResource ConsoleFieldColor}" />
    <SolidColorBrush x:Key="KeylineBrush" Color="{StaticResource KeylineColor}" />
    <SolidColorBrush x:Key="BoneBrush" Color="{StaticResource BoneColor}" />
    <SolidColorBrush x:Key="TidewashBrush" Color="{StaticResource TidewashColor}" />
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource EmberColor}" />
    <SolidColorBrush x:Key="EmberLightBrush" Color="{StaticResource EmberLightColor}" />
    <!-- ConsolePalette.Brass aliases DesignTokens.Accent. -->
    <SolidColorBrush x:Key="BrassBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFFFF" />

    <!-- ============ P2-B: control styles and templates ================= -->

    <!-- Transparent chrome for the owner-drawn clickable base (UiClickable);
         hover/press visuals are painted by subclasses, never by the button. -->
    <Style x:Key="UiClickableStyle" TargetType="controls:UiClickable">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:UiClickable">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ChamferButton (legacy UiControls.cs :51-285; v4.0.1 glass polish): full
         pill (radius = height/2), optional leading glyph in its own nested
         circular chip, optional trailing glyph chip (button-in-button).
         Role and state colours are assigned from code (RefreshVisual); the
         chip hover physics and press scale are driven from code as composition
         animations with the shared KeySpline(0.32,0.72,0,1). -->
    <Style x:Key="ChamferButtonStyle" TargetType="controls:ChamferButton">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RingBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="42" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="ShapeCornerRadius" Value="21" />
        <Setter Property="InnerCornerRadius" Value="19" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ChamferButton">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Shape"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding ShapeCornerRadius}">
                            <Grid>
                                <Border x:Name="InnerHighlight"
                                        Margin="3,1,3,2"
                                        CornerRadius="{TemplateBinding InnerCornerRadius}"
                                        BorderBrush="{StaticResource InnerHighlightBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed" />
                                <Grid Padding="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Leading glyph chip (button-in-button, flush with inner padding). -->
                                    <Grid x:Name="LeadGlyphHost"
                                          Grid.Column="0"
                                          Width="22" Height="22"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed">
                                        <Ellipse x:Name="LeadChip" Fill="{StaticResource ChipLightBrush}" />
                                        <TextBlock x:Name="LeadGlyphText"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                    <ContentPresenter x:Name="TextHost"
                                                      Grid.Column="1"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      FontSize="{TemplateBinding FontSize}"
                                                      FontWeight="{TemplateBinding FontWeight}" />
                                    <Grid x:Name="GlyphHost"
                                          Grid.Column="2"
                                          Width="22" Height="22"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed">
                                        <Ellipse x:Name="TrailChip" Fill="{StaticResource ChipLightBrush}" />
                                        <TextBlock x:Name="GlyphText"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="1"
                                CornerRadius="{TemplateBinding ShapeCornerRadius}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleSwitch (legacy UiControls.cs :683-832): capsule track
         (Border -> brass cross-fade), white thumb translated by Composition
         (~150 ms), accent focus ring. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="controls:ToggleSwitch">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToggleSwitch">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Track"
                                Margin="1,3,1,3"
                                CornerRadius="999"
                                Background="{StaticResource BorderBrush}">
                            <Border x:Name="TrackOn"
                                    CornerRadius="999"
                                    Background="{StaticResource AccentBrush}"
                                    Opacity="0" />
                        </Border>
                        <Border x:Name="Thumb"
                                Width="20" Height="20"
                                CornerRadius="999"
                                Background="{StaticResource ThumbBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0" />
                        <Border x:Name="FocusRing"
                                Margin="0,1"
                                CornerRadius="6"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StripView cell (legacy UiControls.cs :887-914): keyline outline always,
         fill only for parseable tokens, brass magic tick under cell 0. -->
    <DataTemplate x:Key="StripCellTemplate">
        <Grid Width="26" Height="22">
            <Border Width="26" Height="18"
                    VerticalAlignment="Top"
                    Background="{Binding Fill}"
                    BorderBrush="{StaticResource KeylineBrush}"
                    BorderThickness="1" />
            <Rectangle Width="26" Height="2"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource BrassBrush}"
                       Visibility="{Binding TickVisibility}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
